# Backend only. Generate a random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Qiniu OpenAI-compatible chat API. Keep credentials server-side; never use a VITE_ prefix.
QINIU_API_KEY=replace-with-your-qiniu-api-key
QINIU_OPENAI_BASE_URL=https://api.qnaigc.com/v1
QINIU_CHAT_MODEL=qwen/qwen3.8-flash-next

# DashScope Embedding (separate Alibaba Cloud API key; do not reuse Qiniu api-key).
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=replace-with-workspace-id
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
# Or set the complete OpenAI-compatible endpoint directly:
# DASHSCOPE_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Optional: Notes AI uses this only if configured.
ZHIPU_API_KEY=
